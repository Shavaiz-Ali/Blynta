{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "AUTH_SECRET",
    "BLYNTA_APP_AUTH_SECRET",
    "BLYNTA_ADMIN_AUTH_SECRET",
    "BLYNTA_STUDIO_AUTH_SECRET",
    "BLYNTA_AUTH_SECRET",
    "NEXTAUTH_SECRET",
    "AUTH_URL",
    "AUTH_APP_URL",
    "MAIN_APP_URL",
    "STUDIO_APP_URL",
    "ADMIN_APP_URL",
    "BACKEND_URL",
    "NEXT_PUBLIC_BACKEND_URL",
    "NEXT_PUBLIC_API_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "FACEBOOK_CLIENT_ID",
    "FACEBOOK_CLIENT_SECRET",
    "CENTRAL_AUTH_ENABLED",
    "SSO_BRIDGE_SECRET",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_STUDIO_URL",
    "NEXT_PUBLIC_BLYNTA_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
