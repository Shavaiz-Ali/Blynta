# Database & Server
MONGO_URI="mongodb://localhost:27017/blynta"
JWT_SECRET="YOUR_JWT_SECRET"
PORT=5001
FRONTEND_URL="http://localhost:3000"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Bounded per-process media capacity (integers 1..8, defaults to 1).
PIPELINE_CONCURRENCY=1
RENDER_CONCURRENCY=1
RENDER_GLOBAL_CONCURRENCY=1
STUDIO_CONCURRENCY=1
# Shared across every media command on this host, including yt-dlp and whisper.
MEDIA_HOST_CONCURRENCY=1
# All workers/releases on the same host MUST use the same directory and slot count.
MEDIA_HOST_LOCK_DIR=/tmp/blynta-media-slots
FFMPEG_THREADS=1
# Linux supervisor terminates orphaned/hung commands after this many seconds.
MEDIA_COMMAND_TIMEOUT_SECONDS=1800
# all also runs existing Studio jobs; choose pipeline/render for independent worker processes.
MEDIA_WORKER_ROLE=all
# Queue-aware recovery, incomplete fan-out and completion publication repair.
RECONCILE_IN_WORKER=true
STORAGE_ROOT=/var/blynta/storage

# Email
RESEND_API_KEY=""
MAIL_PROVIDER="gmail"
MAIL_FROM_ADDRESS="Blynta <noreply@blynta.com>"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER=""
MAIL_PASSWORD=""

# AI / LLM
LLM_PROVIDER="google"
LLM_MODEL_NAME="gemini-3.5-flash-lite"
LLM_API_KEY=""
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Transcription
TRANSCRIPTION_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"

# Storage (Cloudflare R2)
R2_BUCKET_NAME="blynta"
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Paddle Billing (Sandbox)
PADDLE_ENV="sandbox"
PADDLE_API_KEY="pdl_sdbx_apikey_..."
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
PADDLE_PRICE_ID_PRO="pri_..."
PADDLE_PRICE_ID_BUSINESS="pri_..."

# YouTube Direct Publishing
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5001/youtube/callback"
YOUTUBE_OAUTH_SCOPES="https://www.googleapis.com/auth/youtube.upload"
TOKEN_ENCRYPTION_KEY=""

# BEGIN PRODUCTION REFERENCE
