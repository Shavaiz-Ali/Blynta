# Database & Server
MONGO_URI="mongodb://localhost:27017/blynta"
JWT_SECRET="YOUR_JWT_SECRET"
PORT=5001
FRONTEND_URL="http://localhost:3000"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Bounded per-process media capacity (integers 1..8, defaults to 1).
PIPELINE_CONCURRENCY=1
RENDER_CONCURRENCY=1
RENDER_GLOBAL_CONCURRENCY=1
STUDIO_CONCURRENCY=1
# Shared across every media command on this host, including yt-dlp and whisper.
MEDIA_HOST_CONCURRENCY=1
# All workers/releases on the same host MUST use the same directory and slot count.
MEDIA_HOST_LOCK_DIR=/tmp/blynta-media-slots
FFMPEG_THREADS=1
# Linux supervisor terminates orphaned/hung commands after this many seconds.
MEDIA_COMMAND_TIMEOUT_SECONDS=1800
# all also runs existing Studio jobs; choose pipeline/render for independent worker processes.
MEDIA_WORKER_ROLE=all

# Phase 1 editing previews. Dedicated workers may use MEDIA_WORKER_ROLE=editing.
EDIT_RENDER_CONCURRENCY=1
EDIT_RENDER_TIMEOUT_SECONDS=1800
EDIT_SOURCE_MAX_BYTES=524288000
# Queue-aware recovery, incomplete fan-out and completion publication repair.
RECONCILE_IN_WORKER=true
STORAGE_ROOT=/var/blynta/storage

# Email
RESEND_API_KEY=""
MAIL_PROVIDER="gmail"
MAIL_FROM_ADDRESS="Blynta <noreply@blynta.com>"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER=""
MAIL_PASSWORD=""

# AI / LLM
LLM_PROVIDER="google"
LLM_MODEL_NAME="gemini-3.5-flash-lite"
LLM_API_KEY=""
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Transcription
TRANSCRIPTION_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"

# Storage (Cloudflare R2)
R2_BUCKET_NAME="blynta"
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Paddle Billing (Sandbox)
PADDLE_ENV="sandbox"
PADDLE_API_KEY="pdl_sdbx_apikey_..."
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
PADDLE_PRICE_ID_PRO="pri_..."
PADDLE_PRICE_ID_BUSINESS="pri_..."

# YouTube Direct Publishing
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5001/youtube/callback"
YOUTUBE_OAUTH_SCOPES="https://www.googleapis.com/auth/youtube.upload"
TOKEN_ENCRYPTION_KEY=""

# BEGIN PRODUCTION REFERENCE
# Reference only: all values below are commented out.
# Production: use these URLs in the deployment environment; keep each app secret independent.
# NODE_ENV=production
# AUTH_APP_URL=https://auth-blynta.vercel.app
# MAIN_APP_URL=https://blynta.vercel.app
# STUDIO_APP_URL=https://studio-blynta.vercel.app
# ADMIN_APP_URL=https://admin-blynta.vercel.app
# FRONTEND_URL=https://blynta.vercel.app
# SSO_CLIENTS={"blynta-main":["https://blynta.vercel.app/auth/callback"],"blynta-studio":["https://studio-blynta.vercel.app/auth/callback"]}
# ALLOWED_ORIGINS=https://blynta.vercel.app,https://studio-blynta.vercel.app,https://admin-blynta.vercel.app,https://auth-blynta.vercel.app
# ALLOW_LEGACY_AUTH_TOKENS=false
# SSO_BRIDGE_SECRET=replace-with-the-same-private-secret-as-central-auth
# END PRODUCTION REFERENCE

# Unified credits: migrate explicitly before enabling on APIs AND media workers.
BILLING_CREDITS_V2=false
# Optional. A changed rate must use a new version; admitted work keeps its snapshot.
# BILLING_PRICING_JSON={"version":"2026-10-v1","sourceSeconds":300,"outputSeconds":60,"studioSeconds":60,"studioModifier":1,"aiCredits":1}
# Optional estimated USD rates; missing costs remain unknown, never customer charges.
# BILLING_COST_RATES_JSON={"openai/gpt-4o-mini":{"inputPerMillion":0.15,"outputPerMillion":0.6},"transcription":{"audioPerMinute":0.006},"ffmpeg":{"cpuPerHour":0.1}}
# Isolated replica-set URI ONLY for destructive test database setup/teardown.
# BILLING_TEST_MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0

# Optional structured high-cost alert threshold in USD per processing attempt.
# BILLING_COST_WARNING_USD=1

# Editing output disk budget and optional explicit font paths
EDIT_OUTPUT_MAX_BYTES=209715200
# EDIT_FONT_SANS=/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf
# EDIT_FONT_SERIF=/usr/share/fonts/truetype/liberation2/LiberationSerif-Regular.ttf
# EDIT_FONT_MONO=/usr/share/fonts/truetype/liberation2/LiberationMono-Regular.ttf

# Database-backed AI editing registry (existing highlight LLM configuration stays unchanged)
AI_CREDENTIAL_KEY_VERSION=v1
# Supply base64-encoded random 32-byte keys through your secret manager. Keep old versions during rotation.
# AI_CREDENTIAL_KEYS={"v1":"BASE64_32_BYTE_KEY"}
AI_AGENT_DAILY_REQUEST_LIMIT=50
# Required only for the explicit credential bootstrap command
# AI_BOOTSTRAP_ADMIN_ID=ACTIVE_ADMIN_OBJECT_ID
# Optional live smoke test uses AI_TEST_API_KEY and AI_TEST_MODEL_ID, never application .env
