# Merge into existing backend configuration; keep current database/JWT/Redis settings.
AUTH_APP_URL=http://localhost:3003
MAIN_APP_URL=http://localhost:3000
STUDIO_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3001
SSO_BRIDGE_SECRET=replace-with-a-cryptographically-random-secret
SSO_CLIENTS={"blynta-main":["http://localhost:3000/auth/callback"],"blynta-studio":["http://localhost:3002/auth/callback"]}
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
ALLOW_LEGACY_AUTH_TOKENS=false
# Set true ONLY during an explicit legacy-product rollout; unlinked JWTs cannot participate in SSO logout.

# BEGIN PRODUCTION REFERENCE
# Reference only: all values below are commented out.
# Production: use these URLs in the deployment environment; keep each app secret independent.
# NODE_ENV=production
# AUTH_APP_URL=https://auth-blynta.vercel.app
# MAIN_APP_URL=https://blynta.vercel.app
# STUDIO_APP_URL=https://studio-blynta.vercel.app
# ADMIN_APP_URL=https://admin-blynta.vercel.app
# FRONTEND_URL=https://blynta.vercel.app
# SSO_CLIENTS={"blynta-main":["https://blynta.vercel.app/auth/callback"],"blynta-studio":["https://studio-blynta.vercel.app/auth/callback"]}
# ALLOWED_ORIGINS=https://blynta.vercel.app,https://studio-blynta.vercel.app,https://admin-blynta.vercel.app,https://auth-blynta.vercel.app
# ALLOW_LEGACY_AUTH_TOKENS=false
# SSO_BRIDGE_SECRET=replace-with-the-same-private-secret-as-central-auth
# END PRODUCTION REFERENCE
