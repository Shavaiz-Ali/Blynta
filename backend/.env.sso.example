# Merge into existing backend configuration; keep current database/JWT/Redis settings.
AUTH_APP_URL=http://localhost:3003
MAIN_APP_URL=http://localhost:3000
STUDIO_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3001
SSO_BRIDGE_SECRET=replace-with-a-cryptographically-random-secret
SSO_CLIENTS={"blynta-main":["http://localhost:3000/auth/callback"],"blynta-studio":["http://localhost:3002/auth/callback"],"blynta-admin":["http://localhost:3001/auth/callback"]}
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
ALLOW_LEGACY_AUTH_TOKENS=false
# Set true ONLY during an explicit legacy-product rollout; unlinked JWTs cannot participate in SSO logout.
# Production callback registry (replace the development value; do not merge localhost into production):
# SSO_CLIENTS={"blynta-main":["https://app.blynta.com/auth/callback"],"blynta-studio":["https://studio.blynta.com/auth/callback"],"blynta-admin":["https://admin.blynta.com/auth/callback"]}
# ALLOWED_ORIGINS=https://app.blynta.com,https://admin.blynta.com,https://auth.blynta.com
# Add Studio/Web only if they make direct browser requests to this backend.
