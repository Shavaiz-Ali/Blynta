{
  "name": "blynta-platform",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "setup:auth": "node scripts/setup-local-auth.mjs",
    "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,json,css,scss,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,cjs,mjs,ts,tsx,json,css,scss,yaml,yml}\"",
    "test:sso": "node scripts/test-sso.mjs",
    "test:auth-errors": "node --test scripts/tests/identity-client.test.mjs",
    "test:startup": "node scripts/test-startup.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.5.0"
  }
}
